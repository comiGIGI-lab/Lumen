# 统一换行符，避免 Windows / macOS / Linux 之间来回转换产生噪声 diff
* text=auto eol=lf

# Windows 批处理必须用 CRLF，否则某些版本的 cmd.exe 执行多行 if 块会出错
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.exe  binary
*.woff binary
*.woff2 binary
