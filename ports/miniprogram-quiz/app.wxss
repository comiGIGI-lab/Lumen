page {
  background: #FBF9F6;
  color: #191919;
  font-size: 28rpx;
  line-height: 1.6;
}

.wrap {
  padding: 32rpx 32rpx 48rpx;
}

.kicker {
  font-size: 22rpx;
  color: #A39B92;
  letter-spacing: 2rpx;
}

.h1 {
  font-size: 48rpx;
  font-weight: 500;
  margin-top: 8rpx;
  line-height: 1.3;
}

.sub {
  color: #4A4540;
  margin-top: 12rpx;
  font-size: 28rpx;
}

.card {
  background: #FFFFFF;
  border: 1rpx solid #E4DED5;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-top: 24rpx;
}

.btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #E51520;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.btn-ghost {
  background: #FFFFFF;
  color: #191919;
  border: 1rpx solid #E4DED5;
}

.muted {
  color: #808080;
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  color: #E51520;
  background: #FDECEE;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.demo {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #808080;
  background: #F8F3EC;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
