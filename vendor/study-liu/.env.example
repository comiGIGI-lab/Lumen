# ============================================================
# study-liu 环境变量模板
#
# 用法：把本文件复制为同目录下的 `.env`，然后填入你自己的 Key。
#       `.env` 已被 .gitignore 排除，不会被提交。
#
# 优先级：界面设置（settings.json）> .env > 系统环境变量
# ============================================================

# 运行模式：
#   mock —— 不调用任何在线接口，全部走内置模板（离线可用，演示零风险）
#   llm  —— 调用真实大模型（需填下面的 LLM_API_KEY）
LLM_PROVIDER=llm

# 你的 API Key —— 从各平台官网获取，例如 https://platform.deepseek.com
# ⚠️ 留空时不会报错，会自动回落到内置模板，并在结果里标注 degraded
LLM_API_KEY=

# API 地址（下列 5 家都兼容 OpenAI 格式，按需替换）
#   DeepSeek      https://api.deepseek.com
#   OpenAI        https://api.openai.com/v1
#   通义千问       https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM       https://open.bigmodel.cn/api/paas/v4
#   月之暗面 Kimi  https://api.moonshot.cn/v1
LLM_BASE_URL=https://api.deepseek.com

# 模型名称
#   deepseek-chat / gpt-4o-mini / qwen-plus / glm-4-flash / moonshot-v1-8k
LLM_MODEL=deepseek-chat
